parametersSchema:
    apiLibrary: structure([
        rootNamespace: string(),
        docsHost: string(),
        facadeClass: string(),
        repositoryInterface: string(),
        apiException: string(),
        internalException: string(),
        entityBaseClass: string(),
        queryParamsClass: string(),
        responseRootClass: string(),
        responseObjectClass: string(),
        responseContract: string(),
        requestOptionsClass: string(),
        prepareDateMethod: string(),
        toArrayFunction: string(),
        enumDocblockPrefix: string(),
        requestDtoClasses: listOf(string()),
        testResponseTrait: string(),
    ])

services:
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Config
        arguments:
            rootNamespace: %apiLibrary.rootNamespace%
            docsHost: %apiLibrary.docsHost%
            facadeClass: %apiLibrary.facadeClass%
            repositoryInterface: %apiLibrary.repositoryInterface%
            apiException: %apiLibrary.apiException%
            internalException: %apiLibrary.internalException%
            entityBaseClass: %apiLibrary.entityBaseClass%
            queryParamsClass: %apiLibrary.queryParamsClass%
            responseRootClass: %apiLibrary.responseRootClass%
            responseObjectClass: %apiLibrary.responseObjectClass%
            responseContract: %apiLibrary.responseContract%
            requestOptionsClass: %apiLibrary.requestOptionsClass%
            prepareDateMethod: %apiLibrary.prepareDateMethod%
            toArrayFunction: %apiLibrary.toArrayFunction%
            enumDocblockPrefix: %apiLibrary.enumDocblockPrefix%
            requestDtoClasses: %apiLibrary.requestDtoClasses%
            testResponseTrait: %apiLibrary.testResponseTrait%
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\NoStrictTypes\NoStrictTypesRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\DoubleQuotedStrings\DoubleQuotedStringsRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\Utf8\Utf8Rule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\OneTypePerFile\OneTypePerFileRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\FileNameMatchesType\FileNameMatchesTypeRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\NamespaceMirrorsPath\NamespaceMirrorsPathRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\TestNamespace\TestNamespaceRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\ReadonlyFinalSchema\ReadonlyFinalSchemaRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\ParamsExtendQueryParams\ParamsExtendQueryParamsRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\ResponseExtendsBase\ResponseExtendsBaseRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\EntityExtendsBase\EntityExtendsBaseRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\EntityModuleLayout\EntityModuleLayoutRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\NoCrossEntityImports\NoCrossEntityImportsRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\SharedDoesNotImportEntities\SharedDoesNotImportEntitiesRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\NoHttpInEntities\NoHttpInEntitiesRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\NoAuthorizationInEntities\NoAuthorizationInEntitiesRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\NoBracketQueryNames\NoBracketQueryNamesRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireEntitySee\RequireEntitySeeRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireRepositoryThrows\RequireRepositoryThrowsRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\PhpDocParamNames\PhpDocParamNamesRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\PhpDocParamTypes\PhpDocParamTypesRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireEntityReturnDoc\RequireEntityReturnDocRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\EntityMethodDocOrder\EntityMethodDocOrderRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireDocblockSummary\RequireDocblockSummaryRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\EnumDocblock\EnumDocblockRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\BackedEnum\BackedEnumRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\ScreamingSnakeEnumCase\ScreamingSnakeEnumCaseRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\ParamsPrepareDate\ParamsPrepareDateRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\ParamsCallParent\ParamsCallParentRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\EntityRepositoryCall\EntityRepositoryCallRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireForwardedParams\RequireForwardedParamsRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\EndpointKebabCase\EndpointKebabCaseRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireFacadeRegistration\RequireFacadeRegistrationRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireEntitySpec\RequireEntitySpecRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\FixturePlacement\FixturePlacementRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\TestMethodName\TestMethodNameRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\EntityTestExtendsTestCase\EntityTestExtendsTestCaseRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\EntityTestUsesTrait\EntityTestUsesTraitRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireGetInstance\RequireGetInstanceRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireInheritDoc\RequireInheritDocRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireRepositoryInheritDoc\RequireRepositoryInheritDocRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\ReadonlyRequestDto\ReadonlyRequestDtoRule
        arguments:
            config: @AlexandreBellas\CodeConventions\PhpStan\Config
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\FunctionExistsWrapper\FunctionExistsWrapperRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\EntityMethodsArePublic\EntityMethodsArePublicRule
        tags: [phpstan.rules.rule]
