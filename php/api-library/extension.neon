        class: AlexandreBellas\CodeConventions\PhpStan\Rules\RequireRepositoryInheritDocRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\ReadonlyRequestDtoRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\FunctionExistsWrapperRule
        tags: [phpstan.rules.rule]
    -
        class: AlexandreBellas\CodeConventions\PhpStan\Rules\EntityMethodsArePublicRule
        tags: [phpstan.rules.rule]
